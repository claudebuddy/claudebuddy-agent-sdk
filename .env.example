# Required: your LLM API key
# New prefix (recommended):
CLAUDEBUDDY_API_KEY=sk-or-...
# Legacy prefix (still supported):
# CODEANY_API_KEY=sk-or-...

# Optional: override model
# CLAUDEBUDDY_MODEL=anthropic/claude-sonnet-4

# Optional: custom API endpoint (e.g. third-party proxy)
# CLAUDEBUDDY_BASE_URL=https://openrouter.ai/api