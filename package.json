{
  "name": "@claudebuddy/claudebuddy-agent-sdk",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": {
    "name": "LuckyGJX",
    "url": "https://github.com/LuckyGJX"
  },
  "homepage": "https://github.com/claudebuddy/claudebuddy-agent-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/claudebuddy/claudebuddy-agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/claudebuddy/claudebuddy-agent-sdk/issues"
  },
  "version": "0.4.0",
  "description": "Open-source Agent SDK. Runs the full agent loop in-process — no local CLI required. Deploy anywhere: cloud, serverless, Docker, CI/CD.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npx tsx examples/01-simple-query.ts",
    "test:all": "for f in examples/*.ts; do echo \"--- Running $f ---\"; npx tsx $f; echo; done",
    "web": "npx tsx examples/web/server.ts",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org/",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "open-agent-sdk",
    "agent",
    "sdk",
    "ai",
    "llm",
    "tools",
    "agentic",
    "coding-agent",
    "mcp"
  ],
  "license": "MIT"
}
